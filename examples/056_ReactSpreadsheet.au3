#Tidy_ILC_Pos=44
#AutoIt3Wrapper_Au3Check_Parameters=-d -w 1 -w 2 -w 3 -w 4 -w 5 -w 6 -w 7
#include <FileConstants.au3>
#include <GUIConstantsEx.au3>
#include <MsgBoxConstants.au3>
#include <WindowsConstants.au3>
#include "..\WebView2.au3"

Opt("MustDeclareVars", 1)

Global Const $g_sOrigin = "https://udf-virtual-host.example"
Global $g_iSaveID = 0, $g_sSaveName = ""

Exit _Example()

; #INTERNAL_USE_ONLY# ==============================================================================================================
; Name...........: _Example
; Description....: Hosts the offline spreadsheet editor in a standalone window.
; Syntax.........: _Example()
; Parameters.....: None.
; Return values..: 0 on normal close; 1 on startup failure.
; Author.........: mLipok
; Modified.......:
; Remarks........: Uses an isolated temporary WebView2 profile.
; Related........: _WebView2_Create, _WebView2_SetBounds
; Link...........:
; Example........: No
; ===============================================================================================================================
Func _Example()
	Local $hWindow = GUICreate("WebView2 - Spreadsheet editor", 1160, 720, -1, -1, BitOR($WS_OVERLAPPEDWINDOW, $WS_CLIPCHILDREN))
	GUISetState(@SW_MAXIMIZE, $hWindow)
	GUISetState(@SW_SHOWNOACTIVATE, $hWindow)
	Local $sProfile = @TempDir & "\WebView2-056-" & @AutoItPID & "-" & Random(100000, 999999, 1)
	Local $iView = -1, $iExitCode = 1
	Do
		If Not _WebView2_Init(Default, $sProfile) Then ExitLoop
		Local $aSize = WinGetClientSize($hWindow)
		$iView = _WebView2_Create($hWindow, 0, 0, $aSize[0], $aSize[1])
		If @error Then
			$iView = -1
			ExitLoop
		EndIf
		If Not _WebView2_SetCallback($iView, $WEBVIEW2_EVENT_DOWNLOAD_STARTING, _DownloadStarting) Then ExitLoop
		If Not _WebView2_SetDefaultScriptDialogsEnabled($iView, True) Then ExitLoop
		If Not _WebView2_SetVirtualHostNameToFolderMapping($iView, "udf-virtual-host.example", @ScriptDir & "\assets\native\056-spreadsheet") Then ExitLoop
		If Not _WebView2_Navigate($iView, $g_sOrigin & "/index.html") Then ExitLoop

		While True
			Switch GUIGetMsg()
				Case $GUI_EVENT_CLOSE
					ExitLoop
				Case $GUI_EVENT_RESIZED, $GUI_EVENT_MAXIMIZE, $GUI_EVENT_RESTORE
					$aSize = WinGetClientSize($hWindow)
					If IsArray($aSize) And $aSize[0] > 0 And $aSize[1] > 0 Then _WebView2_SetBounds($iView, 0, 0, $aSize[0], $aSize[1])
			EndSwitch
			If $g_iSaveID Then _ProcessSave($iView, $hWindow, $g_iSaveID)
		WEnd
		$iExitCode = 0
	Until True
	If $iExitCode Then MsgBox($MB_ICONERROR, "Spreadsheet editor", "Could not start WebView2." & @CRLF & _WebView2_Error_GetDescription(), 0, $hWindow)
	If $iView >= 0 Then _WebView2_Destroy($iView)
	_WebView2_Cleanup()
	GUIDelete($hWindow)
	If FileExists($sProfile) Then DirRemove($sProfile, 1)
	Return $iExitCode
EndFunc   ;==>_Example

; #INTERNAL_USE_ONLY# ==============================================================================================================
; Name...........: _DownloadStarting
; Description....: Defers a workbook copy generated by the local editor.
; Syntax.........: _DownloadStarting($iView, $iDownload, $sURI, $sSuggested, $sMime)
; Parameters.....: Native download callback fields.
; Return values..: Deferred or cancelled download policy.
; Author.........: mLipok
; Modified.......:
; Remarks........: The save dialog is handled outside this native callback.
; Related........: _ProcessSave
; Link...........:
; Example........: No
; ===============================================================================================================================
Func _DownloadStarting($iView, $iDownload, $sURI, $sSuggested, $sMime)
	#forceref $iView
	If $g_iSaveID Or StringLeft($sURI, StringLen($g_sOrigin) + 6) <> "blob:" & $g_sOrigin & "/" Then Return $WEBVIEW2_DOWNLOAD_CANCEL
	Local $sName = StringRegExpReplace($sSuggested, "^.*[\\/]", "")
	Switch $sMime
		Case "application/vnd.ms-excel"
			If Not StringRegExp($sName, "(?i)-copy\.xls$") Then Return $WEBVIEW2_DOWNLOAD_CANCEL
		Case "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
			If Not StringRegExp($sName, "(?i)-copy\.xlsx$") Then Return $WEBVIEW2_DOWNLOAD_CANCEL
		Case Else
			Return $WEBVIEW2_DOWNLOAD_CANCEL
	EndSwitch
	$g_iSaveID = $iDownload
	$g_sSaveName = $sName
	Return $WEBVIEW2_DOWNLOAD_DEFER
EndFunc   ;==>_DownloadStarting

; #INTERNAL_USE_ONLY# ==============================================================================================================
; Name...........: _ProcessSave
; Description....: Prompts for a new destination and reports the final save status.
; Syntax.........: _ProcessSave($iView, $hWindow, $iDownload)
; Parameters.....: View ID, owner window, and native download ID.
; Return values..: None.
; Author.........: mLipok
; Modified.......:
; Remarks........: Existing files are protected by the UDF download path validation.
; Related........: _WebView2_Download_Complete, _WebView2_Download_GetInfo
; Link...........:
; Example........: No
; ===============================================================================================================================
Func _ProcessSave($iView, $hWindow, $iDownload)
	Local $sStatus = ""
	If $g_sSaveName <> "" Then
		Local $sExtension = StringRegExpReplace($g_sSaveName, "^.*\.", "")
		Local $sPath = FileSaveDialog("Save workbook copy", @MyDocumentsDir, "Excel workbook (*." & $sExtension & ")", _
				$FD_PATHMUSTEXIST, $g_sSaveName, $hWindow)
		Local $iDialogError = @error
		$g_sSaveName = ""
		If $iDialogError Then
			$sStatus = "cancelled"
		Else
			If StringRight($sPath, StringLen($sExtension) + 1) <> "." & $sExtension Then $sPath &= "." & $sExtension
			If FileExists($sPath) Then
				$sStatus = "cancelled"
			ElseIf Not _WebView2_Download_Complete($iDownload, $sPath, True) Then
				$sStatus = "failed"
			EndIf
		EndIf
		If $sStatus <> "" Then _WebView2_Download_Cancel($iDownload)
	Else
		Local $aInfo = _WebView2_Download_GetInfo($iDownload)
		If @error Then
			$sStatus = "failed"
		ElseIf $aInfo[5] = $WEBVIEW2_DOWNLOAD_STATE_COMPLETED Then
			$sStatus = "saved"
		ElseIf $aInfo[5] = $WEBVIEW2_DOWNLOAD_STATE_INTERRUPTED Then
			$sStatus = "failed"
		EndIf
	EndIf
	If $sStatus = "" Then Return
	$g_iSaveID = 0
	_WebView2_ExecuteScript($iView, "window.dispatchEvent(new CustomEvent('spreadsheet-save',{detail:'" & $sStatus & "'}))", 3000)
EndFunc   ;==>_ProcessSave
