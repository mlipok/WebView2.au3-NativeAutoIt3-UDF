#Tidy_ILC_Pos=44
#AutoIt3Wrapper_Au3Check_Parameters=-d -w 1 -w 2 -w 3 -w 4 -w 5 -w 6 -w 7

#include <GUIConstantsEx.au3>
#include <MsgBoxConstants.au3>
#include <WindowsConstants.au3>

#include "..\WebView2.au3"

Opt("MustDeclareVars", 1)

_Example()

; #FUNCTION# ====================================================================================================================
; Name ..........: _Example
; Description ...: Runs the Export PDF MHTML example.
; Syntax ........: _Example()
; Parameters ....: None.
; Return values .: No value; shows the result in the example GUI or console.
; Author ........: mLipok
; Modified ......:
; Remarks .......:
; Related .......:
; Link ..........:
; Example .......: Yes
; ===============================================================================================================================
Func _Example()
	Local $__WebView2ExitValue = 0
	Local $__WebView2ExitError = 0, $__WebView2ExitExtended = 0
	Do
		Local $hGUI = GUICreate("WebView2.au3 - PDF / MHTML", 1000, 700, -1, -1, $WS_OVERLAPPEDWINDOW)
		GUISetState(@SW_SHOW, $hGUI)

		If Not _WebView2_Init() Then
			$__WebView2ExitValue = _Error("Init")
			$__WebView2ExitError = @error
			$__WebView2ExitExtended = @extended
			ExitLoop 1
		EndIf
		Local $iWebView = _WebView2_Create($hGUI, 0, 0, 1000, 700)
		If @error Then
			$__WebView2ExitValue = _Error("Create")
			$__WebView2ExitError = @error
			$__WebView2ExitExtended = @extended
			ExitLoop 1
		EndIf

		Local $sHTML = '<!doctype html><html><head><title>Export demo</title></head><body style="font-family:Segoe UI;padding:30px"><h1>PDF / MHTML</h1><p>Generated by WebView2.au3.</p></body></html>'
		_WebView2_NavigateToString($iWebView, $sHTML)
		If Not _WebView2_LoadWait($iWebView) Then
			$__WebView2ExitValue = _Error("LoadWait")
			$__WebView2ExitError = @error
			$__WebView2ExitExtended = @extended
			ExitLoop 1
		EndIf

		Local $bPdf = _WebView2_ExportToPdfBinary($iWebView)
		If @error Then
			$__WebView2ExitValue = _Error("PDF Binary")
			$__WebView2ExitError = @error
			$__WebView2ExitExtended = @extended
			ExitLoop 1
		EndIf
		ConsoleWrite("PDF Binary bytes=" & BinaryLen($bPdf) & @CRLF)

		Local $bMhtml = _WebView2_ExportToMhtmlBinary($iWebView)
		If @error Then
			$__WebView2ExitValue = _Error("MHTML Binary")
			$__WebView2ExitError = @error
			$__WebView2ExitExtended = @extended
			ExitLoop 1
		EndIf
		ConsoleWrite("MHTML Binary bytes=" & BinaryLen($bMhtml) & @CRLF)

		Local $sPdfFile = @ScriptDir & "\WebView2_Export_Demo.pdf"
		Local $sMhtmlFile = @ScriptDir & "\WebView2_Export_Demo.mhtml"
		If Not _WebView2_ExportToPdfFile($iWebView, $sPdfFile) Then
			$__WebView2ExitValue = _Error("PDF File")
			$__WebView2ExitError = @error
			$__WebView2ExitExtended = @extended
			ExitLoop 1
		EndIf
		If Not _WebView2_ExportToMhtmlFile($iWebView, $sMhtmlFile) Then
			$__WebView2ExitValue = _Error("MHTML File")
			$__WebView2ExitError = @error
			$__WebView2ExitExtended = @extended
			ExitLoop 1
		EndIf

		MsgBox($MB_ICONINFORMATION, "Export complete", "PDF: " & $sPdfFile & @CRLF & "MHTML: " & $sMhtmlFile)

		While GUIGetMsg() <> $GUI_EVENT_CLOSE
		WEnd

		_WebView2_Cleanup()
		GUIDelete($hGUI)
	Until True
	Return SetError($__WebView2ExitError, $__WebView2ExitExtended, $__WebView2ExitValue)
EndFunc   ;==>_Example

; #FUNCTION# ====================================================================================================================
; Name ..........: _Error
; Description ...: Reports a failed WebView2 operation and its diagnostic.
; Syntax ........: _Error($sStage)
; Parameters ....: $sStage - Name of the failed example stage.
; Return values .: No value; shows the result in the example GUI or console.
; Author ........: mLipok
; Modified ......:
; Remarks .......:
; Related .......:
; Link ..........:
; Example .......: Yes
; ===============================================================================================================================
Func _Error($sStage)
	MsgBox($MB_ICONERROR, "WebView2 " & $sStage, _WebView2_Error_GetDescription())
	_WebView2_Cleanup()
	Return
EndFunc   ;==>_Error
